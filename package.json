{
  "name": "tinhthanhvn",
  "displayName": "Tỉnh Thành Việt Nam",
  "description": "Lookup Vietnam provinces, districts, and wards before and after the 2025 administrative merger.",
  "version": "1.0.1",
  "author": "Cuong Nguyen",
  "license": "MIT",
  "homepage": "https://github.com/nguyencongcuong/tinhthanhvn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyencongcuong/tinhthanhvn.git"
  },
  "bugs": {
    "url": "https://github.com/nguyencongcuong/tinhthanhvn/issues"
  },
  "keywords": [
    "vietnam",
    "provinces",
    "districts",
    "wards",
    "administrative",
    "geography",
    "lookup",
    "typescript"
  ],
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./current": {
      "types": "./dist/current.d.ts",
      "import": "./dist/current.js",
      "default": "./dist/current.js"
    },
    "./pre": {
      "types": "./dist/pre.d.ts",
      "import": "./dist/pre.js",
      "default": "./dist/pre.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/current.ts src/pre.ts --outdir dist --target node && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "format": "biome check --write .",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "publishConfig": {
    "access": "public"
  }
}
